+    static const wchar_t* DungeonCountReasonText(CountSkipReason reason) {
+        switch (reason) {
+            case CountSkipReason::WrongGroup: return L"sai nhóm/bộ lọc";
+            case CountSkipReason::OutsideRadius: return L"ngoài bán kính";
+            case CountSkipReason::NotSeenAlive: return L"chưa thấy sống";
+            case CountSkipReason::RoleIdChanged: return L"đổi RoleID";
+        }
+        return L"không rõ";
+    }

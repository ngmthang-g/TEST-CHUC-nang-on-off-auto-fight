+    int SelectedDungeonStageIndex() const {
+        if (!dungeonStageList_) return 0;
+        const int row = ListView_GetNextItem(dungeonStageList_, -1, LVNI_SELECTED);
+        return row < 0 ? 0 : row;
+    }

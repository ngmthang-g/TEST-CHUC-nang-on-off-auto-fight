ặc", true, false}},
                            rules, L"THUONG").empty());
     assert(tracker.TrackedLives() == 0); // class proof without live HP proof is still rejected
+
+    std::vector<CountDiagnostic> diagnostics;
+    tracker.Reset(92, 4);
+    (void)tracker.Observe({{40, 999, 100, 100, 0, 0, false, false, L"Đại Vương", true, true}},
+                          rules, L"THUONG", 0, 0, 0, &diagnostics);
+    assert(!diagnostics.empty() && diagnostics.back().reason == CountSkipReason::WrongGroup);
+    diagnostics.clear();
+    (void)tracker.Observe({{41, 501, 100, 100, 500, 500, false, true, L"Sơn Tặc", true, true}},
+                          rules, L"THUONG", 0, 0, 100, &diagnostics);
+    assert(!diagnostics.empty() && diagnostics.back().reason == CountSkipReason::OutsideRadius);
+    diagnostics.clear();
+    (void)tracker.Observe({{42, 501, 0, 100, 0, 0, true, false, L"Sơn Tặc", true, true}},
+                          rules, L"THUONG", 0, 0, 0, &diagnostics);
+    assert(!diagnostics.empty() && diagnostics.back().reason == CountSkipReason::NotSeenAlive);
+    diagnostics.clear();
+    (void)tracker.Observe({{43, 501, 100, 100, 0, 0, false, false, L"Sơn Tặc", true, true}},
+                          rules, L"THUONG");
+    assert(tracker.SeenAliveLives() == 1);
+    (void)tracker.Observe({{44, 501, 0, 100, 0, 0, true, false, L"Sơn Tặc", true, true}},
+                          rules, L"THUONG", 0, 0, 0, &diagnostics);
+    assert(!diagnostics.empty() && diagnostics.back().reason == CountSkipReason::RoleIdChanged);
+
     assert(StageComplete(40, 40));
     assert(!StageComplete(39, 40));
     return 0;
